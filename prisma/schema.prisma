// Vanika Cognitive Care Platform — Prisma Database Schema Proposal
// Learn more about Prisma schema file: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ELDER
  CAREGIVER
  ADMIN
}

enum AppLanguage {
  ENGLISH
  ASSAMESE
  BODO
  KHASI
  MIZO
  NAGAMESE
  HINDI
  BENGALI
  NEPALI
  MANIPURI
}

enum FontScale {
  NORMAL
  LARGE
  EXTRA_LARGE
}

enum VoicePace {
  SLOW
  NORMAL
}

enum RelationshipStatus {
  PENDING
  ACTIVE
  REVOKED
  DECLINED
}

enum GameType {
  PHOTO_RECALL
  CARD_MATCH
  SEQUENCE_ORDER
  SPOT_DIFFERENCE
  HERITAGE_QUIZ
  PATTERN_COMPLETE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
  PAUSED
}

enum RoutinePeriod {
  MORNING
  AFTERNOON
  EVENING
}

enum RoutineCategory {
  MEDICATION
  HYDRATION
  COGNITIVE_ACTIVITY
  MEAL
  WALK
  REST
  OTHER
}

enum NotificationType {
  ACTIVITY_REMINDER
  MEDICATION_REMINDER
  ACHIEVEMENT
  CAREGIVER_ALERT
  SYSTEM
}

enum NotificationSeverity {
  INFO
  ADVISORY
  URGENT
}

// ==========================================
// 1. IDENTITY & AUTHORIZATION
// ==========================================

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String?   @unique @db.VarChar(255)
  phone         String?   @unique @db.VarChar(32)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  role          UserRole  @default(ELDER)
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  // One-to-One relations
  profile               Profile?
  accessibilitySettings AccessibilitySettings?
  userPreferences       UserPreferences?

  // Many-to-Many Caregiver relations
  caregiverFor  CaregiverRelationship[] @relation("CaregiverUser")
  elderFor      CaregiverRelationship[] @relation("ElderUser")

  // Content ownership & telemetry
  ownedContentItems      GameContentItem[]
  gameSessions           GameSession[]
  gameResults            GameResult[]
  dailyProgressSummaries DailyProgressSummary[]
  difficultyHistories    DifficultyHistory[]
  recommendations        ActivityRecommendation[]
  routineTasks           RoutineTask[]
  routineTaskLogs        RoutineTaskLog[]       @relation("UserLogs")
  completedRoutineLogs   RoutineTaskLog[]       @relation("CompleterUser")
  notifications          Notification[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model Profile {
  id                  String      @id @default(uuid()) @db.Uuid
  userId              String      @unique @map("user_id") @db.Uuid
  fullName            String      @map("full_name") @db.VarChar(128)
  nickname            String?     @db.VarChar(64)
  dateOfBirth         DateTime?   @map("date_of_birth") @db.Date
  gender              String?     @db.VarChar(32)
  primaryLanguage     AppLanguage @default(ENGLISH) @map("primary_language")
  location            String      @default("Guwahati, Assam") @db.VarChar(128)
  emergencyPhone      String?     @map("emergency_phone") @db.VarChar(32)
  reminiscenceTopic   String?     @map("reminiscence_topic") @db.Text
  notes               String?     @db.Text
  avatarUrl           String?     @map("avatar_url") @db.VarChar(512)
  onboardingCompleted Boolean     @default(false) @map("onboarding_completed")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([primaryLanguage])
  @@map("profiles")
}

model AccessibilitySettings {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  fontSize          FontScale @default(NORMAL) @map("font_size")
  highContrast      Boolean   @default(false) @map("high_contrast")
  darkMode          Boolean   @default(false) @map("dark_mode")
  reducedMotion     Boolean   @default(false) @map("reduced_motion")
  voiceSpeed        VoicePace @default(SLOW) @map("voice_speed")
  voiceGuideEnabled Boolean   @default(true) @map("voice_guide_enabled")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accessibility_settings")
}

model UserPreferences {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  dailyActivityGoal      Int      @default(2) @map("daily_activity_goal")
  preferredPracticeAreas String[] @default(["memory", "attention"]) @map("preferred_practice_areas") @db.VarChar(64)
  audioFeedbackEnabled   Boolean  @default(true) @map("audio_feedback_enabled")
  offlineSyncEnabled     Boolean  @default(true) @map("offline_sync_enabled")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

// ==========================================
// 2. CAREGIVER & DELEGATION
// ==========================================

model CaregiverRelationship {
  id                String             @id @default(uuid()) @db.Uuid
  elderUserId       String             @map("elder_user_id") @db.Uuid
  caregiverUserId   String             @map("caregiver_user_id") @db.Uuid
  relationshipType  String             @map("relationship_type") @db.VarChar(64)
  status            RelationshipStatus @default(PENDING)
  canViewAnalytics  Boolean            @default(true) @map("can_view_analytics")
  canManageRoutines Boolean            @default(true) @map("can_manage_routines")
  canUploadMemories Boolean            @default(true) @map("can_upload_memories")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  elderUser     User @relation("ElderUser", fields: [elderUserId], references: [id], onDelete: Cascade)
  caregiverUser User @relation("CaregiverUser", fields: [caregiverUserId], references: [id], onDelete: Cascade)

  @@unique([elderUserId, caregiverUserId], name: "uq_caregiver_pair")
  @@index([elderUserId])
  @@index([caregiverUserId])
  @@index([status])
  @@map("caregiver_relationships")
}

// ==========================================
// 3. COGNITIVE ENGINE & CONTENT CATALOG
// ==========================================

model GameCategory {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(128)
  description  String   @db.Text
  icon         String   @db.VarChar(64)
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  games Game[]

  @@index([slug])
  @@map("game_categories")
}

model Game {
  id                       String          @id @default(uuid()) @db.Uuid
  categoryId               String          @map("category_id") @db.Uuid
  slug                     String          @unique @db.VarChar(64)
  title                    String          @db.VarChar(128)
  description              String          @db.Text
  icon                     String          @db.VarChar(64)
  gameType                 GameType        @map("game_type")
  baseDifficulty           DifficultyLevel @default(EASY) @map("base_difficulty")
  estimatedDurationSeconds Int             @default(300) @map("estimated_duration_seconds")
  configSchema             Json            @default("{}") @map("config_schema")
  isActive                 Boolean         @default(true) @map("is_active")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  category GameCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  contentItems        GameContentItem[]
  gameSessions        GameSession[]
  gameResults         GameResult[]
  difficultyHistories DifficultyHistory[]
  recommendations     ActivityRecommendation[]

  @@index([categoryId])
  @@index([slug])
  @@index([gameType])
  @@map("games")
}

model GameContentItem {
  id                String          @id @default(uuid()) @db.Uuid
  gameId            String          @map("game_id") @db.Uuid
  ownerUserId       String?         @map("owner_user_id") @db.Uuid
  title             String          @db.VarChar(255)
  promptText        String          @map("prompt_text") @db.Text
  audioPromptUrl    String?         @map("audio_prompt_url") @db.VarChar(512)
  mediaUrl          String?         @map("media_url") @db.VarChar(512)
  secondaryMediaUrl String?         @map("secondary_media_url") @db.VarChar(512)
  difficultyLevel   DifficultyLevel @default(EASY) @map("difficulty_level")
  culturalRegion    String?         @default("Universal") @map("cultural_region") @db.VarChar(64)
  metadata          Json            @default("{}")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  game      Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ownerUser User? @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  options          GameOption[]
  submittedAnswers SubmittedAnswer[]

  @@index([gameId])
  @@index([ownerUserId])
  @@index([difficultyLevel])
  @@map("game_content_items")
}

model GameOption {
  id             String   @id @default(uuid()) @db.Uuid
  contentItemId  String   @map("content_item_id") @db.Uuid
  optionText     String   @map("option_text") @db.Text
  optionMediaUrl String?  @map("option_media_url") @db.VarChar(512)
  isCorrect      Boolean  @default(false) @map("is_correct")
  displayOrder   Int      @default(0) @map("display_order")
  explanation    String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  contentItem GameContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  submittedAnswers SubmittedAnswer[]

  @@index([contentItemId])
  @@map("game_options")
}

// ==========================================
// 4. TELEMETRY, SESSIONS & RESULTS
// ==========================================

model GameSession {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  gameId          String          @map("game_id") @db.Uuid
  sessionStatus   SessionStatus   @default(IN_PROGRESS) @map("session_status")
  difficultyUsed  DifficultyLevel @default(EASY) @map("difficulty_used")
  startedAt       DateTime        @default(now()) @map("started_at") @db.Timestamptz
  completedAt     DateTime?       @map("completed_at") @db.Timestamptz
  durationSeconds Int?            @map("duration_seconds")
  offlineSynced   Boolean         @default(false) @map("offline_synced")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  submittedAnswers SubmittedAnswer[]
  gameResult       GameResult?

  @@index([userId])
  @@index([gameId])
  @@index([userId, startedAt(sort: Desc)])
  @@map("game_sessions")
}

model SubmittedAnswer {
  id                   String   @id @default(uuid()) @db.Uuid
  sessionId            String   @map("session_id") @db.Uuid
  contentItemId        String   @map("content_item_id") @db.Uuid
  selectedOptionId     String?  @map("selected_option_id") @db.Uuid
  voiceInputTranscript String?  @map("voice_input_transcript") @db.Text
  isCorrect            Boolean  @map("is_correct")
  responseTimeMs       Int      @map("response_time_ms")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  session        GameSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  contentItem    GameContentItem @relation(fields: [contentItemId], references: [id], onDelete: Restrict)
  selectedOption GameOption?     @relation(fields: [selectedOptionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([contentItemId])
  @@map("submitted_answers")
}

model GameResult {
  id                   String   @id @default(uuid()) @db.Uuid
  sessionId            String   @unique @map("session_id") @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  gameId               String   @map("game_id") @db.Uuid
  scoreObtained        Int      @map("score_obtained")
  totalPossibleScore   Int      @map("total_possible_score")
  accuracyPercentage   Decimal  @map("accuracy_percentage") @db.Decimal(5, 2)
  memoryDomainScore    Int      @default(0) @map("memory_domain_score")
  attentionDomainScore Int      @default(0) @map("attention_domain_score")
  patternDomainScore   Int      @default(0) @map("pattern_domain_score")
  strengthsSummary     String[] @default([]) @map("strengths_summary")
  improvementsSummary  String[] @default([]) @map("improvements_summary")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz

  session GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  game    Game        @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([gameId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("game_results")
}

// ==========================================
// 5. ANALYTICS, ADAPTATION & RECOMMENDATIONS
// ==========================================

model DailyProgressSummary {
  id                       String   @id @default(uuid()) @db.Uuid
  userId                   String   @map("user_id") @db.Uuid
  summaryDate              DateTime @map("summary_date") @db.Date
  totalActivitiesCompleted Int      @default(0) @map("total_activities_completed")
  totalActiveSeconds       Int      @default(0) @map("total_active_seconds")
  avgMemoryScore           Decimal  @default(0) @map("avg_memory_score") @db.Decimal(5, 2)
  avgAttentionScore        Decimal  @default(0) @map("avg_attention_score") @db.Decimal(5, 2)
  avgPatternScore          Decimal  @default(0) @map("avg_pattern_score") @db.Decimal(5, 2)
  streakCount              Int      @default(0) @map("streak_count")
  adherencePercentage      Decimal  @default(0) @map("adherence_percentage") @db.Decimal(5, 2)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, summaryDate], name: "uq_user_daily_summary")
  @@index([userId, summaryDate(sort: Desc)])
  @@map("daily_progress_summaries")
}

model DifficultyHistory {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @map("user_id") @db.Uuid
  gameId             String          @map("game_id") @db.Uuid
  previousDifficulty DifficultyLevel @map("previous_difficulty")
  newDifficulty      DifficultyLevel @map("new_difficulty")
  triggerReason      String          @map("trigger_reason") @db.VarChar(255)
  adjustedAt         DateTime        @default(now()) @map("adjusted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([userId, gameId])
  @@map("difficulty_history")
}

model ActivityRecommendation {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  recommendedGameId String    @map("recommended_game_id") @db.Uuid
  reasonCode        String    @map("reason_code") @db.VarChar(64)
  recommendationText String   @map("recommendation_text") @db.Text
  priorityScore     Decimal   @default(1.0) @map("priority_score") @db.Decimal(3, 2)
  isDismissed       Boolean   @default(false) @map("is_dismissed")
  generatedAt       DateTime  @default(now()) @map("generated_at") @db.Timestamptz
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz

  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendedGame Game @relation(fields: [recommendedGameId], references: [id], onDelete: Cascade)

  @@index([userId, isDismissed, priorityScore(sort: Desc)])
  @@map("activity_recommendations")
}

// ==========================================
// 6. DAILY WELLNESS ROUTINES & NOTIFICATIONS
// ==========================================

model RoutineTask {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  title         String          @db.VarChar(128)
  icon          String          @default("📋") @db.VarChar(32)
  scheduledTime DateTime        @map("scheduled_time") @db.Time
  period        RoutinePeriod
  category      RoutineCategory @default(OTHER)
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  logs RoutineTaskLog[]

  @@index([userId, period])
  @@map("routine_tasks")
}

model RoutineTaskLog {
  id                 String    @id @default(uuid()) @db.Uuid
  routineTaskId      String    @map("routine_task_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  scheduledDate      DateTime  @map("scheduled_date") @db.Date
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  isCompleted        Boolean   @default(false) @map("is_completed")
  completedByUserId  String?   @map("completed_by_user_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  routineTask     RoutineTask @relation(fields: [routineTaskId], references: [id], onDelete: Cascade)
  user            User        @relation("UserLogs", fields: [userId], references: [id], onDelete: Cascade)
  completedByUser User?       @relation("CompleterUser", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@unique([routineTaskId, scheduledDate], name: "uq_routine_task_date")
  @@index([userId, scheduledDate])
  @@map("routine_task_logs")
}

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  type      NotificationType
  severity  NotificationSeverity @default(INFO)
  title     String               @db.VarChar(128)
  message   String               @db.Text
  icon      String               @default("🔔") @db.VarChar(32)
  actionUrl String?              @map("action_url") @db.VarChar(255)
  isRead    Boolean              @default(false) @map("is_read")
  readAt    DateTime?            @map("read_at") @db.Timestamptz
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}
